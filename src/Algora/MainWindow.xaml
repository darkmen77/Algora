<Window x:Class="Algora.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="Algora — v0.1.0-alpha.7" Width="1280" Height="800" MinWidth="960" MinHeight="620" KeyDown="Window_KeyDown">
<Window.Resources>
 <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/></Style>
</Window.Resources>
<Grid x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
<Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#5B4FF7" CornerRadius="11" Width="42" Height="42"><TextBlock Text="A" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0"><TextBlock x:Name="TitleText" Text="Algora" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Εργαστήριο Αλγοριθμικής &amp; ΓΛΩΣΣΑΣ" FontSize="11"/></StackPanel></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Content="☾  Θέμα" Click="Theme_Click"/></StackPanel></Grid></Border>
<Border x:Name="Toolbar" Grid.Row="1" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Margin="14,4">
<Button Style="{StaticResource ToolButton}" Content="＋  Νέο" Click="New_Click"/><Button Style="{StaticResource ToolButton}" Content="⌂  Άνοιγμα" Click="Open_Click"/><Button Style="{StaticResource ToolButton}" Content="▣  Αποθήκευση" Click="Save_Click"/>
<Border Width="1" Margin="9,6"/><Button x:Name="RunButton" Style="{StaticResource ToolButton}" Content="▶  Εκτέλεση   F5" Click="Run_Click"/><Button x:Name="StepButton" Style="{StaticResource ToolButton}" Content="⏭  Βήμα   F10" Click="Step_Click"/><Button x:Name="FlowButton" Style="{StaticResource ToolButton}" Content="◇  Διάγραμμα" Click="Flow_Click"/><Button Style="{StaticResource ToolButton}" Content="■  Καθαρισμός" Click="Clear_Click"/></StackPanel></Border>
<Grid Grid.Row="2" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="EditorCard" CornerRadius="12" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
<Border x:Name="EditorHeader" CornerRadius="12,12,0,0"><Grid Margin="14,0"><TextBlock x:Name="EditorHeaderText" Text="Κώδικας" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="FileText" Text="χωρίς τίτλο.glossa" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Border>
<TabControl x:Name="WorkTabs" Grid.Row="1" BorderThickness="0" SelectionChanged="WorkTabs_SelectionChanged"><TabItem Header="Κώδικας"><avalon:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="Cascadia Mono,Consolas" FontSize="15" Padding="10,12" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" KeyDown="Editor_KeyDown"/></TabItem><TabItem Header="Διάγραμμα Ροής"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="FlowCanvas" Width="760" MinHeight="900"/></ScrollViewer></TabItem></TabControl></Grid></Border>
<GridSplitter Grid.Column="1" Width="8" Background="Transparent"/>
<Border x:Name="OutputCard" Grid.Column="2" CornerRadius="12" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="180"/></Grid.RowDefinitions>
<Border x:Name="ConsoleHeader" CornerRadius="12,12,0,0"><TextBlock x:Name="ConsoleHeaderText" Text="  Κονσόλα" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBox x:Name="ConsoleBox" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="14" Padding="14" BorderThickness="0" Text="Έτοιμο για εκτέλεση." TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<Border x:Name="VariablesPanel" Grid.Row="2" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="VariablesTitle" Text="Μεταβλητές" FontWeight="SemiBold" VerticalAlignment="Center"/><DataGrid x:Name="VariablesGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Όνομα" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Τιμή" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
<Border x:Name="TracePanel" Grid.Row="3" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="TraceTitle" Text="Πίνακας Τιμών" FontWeight="SemiBold" VerticalAlignment="Center"/><DataGrid x:Name="TraceGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal"/></Grid></Border>
</Grid></Border></Grid>
<Border x:Name="StatusBar" Grid.Row="3"><Grid Margin="12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Έτοιμο" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="VersionText" Text="Algora v0.1.0-alpha.7   •   F11 Πλήρης οθόνη" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
</Grid></Window>