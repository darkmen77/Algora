<Window x:Class="Algora.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="Algora — v0.1.0-alpha.7" Width="1280" Height="800" MinWidth="960" MinHeight="620" KeyDown="Window_KeyDown">
<Window.Resources>
 <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AAB8CC"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="3,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabPill" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#6D5DFB"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#35455F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
<Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#5B4FF7" CornerRadius="11" Width="42" Height="42"><TextBlock Text="A" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0"><TextBlock x:Name="TitleText" Text="Algora" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Εργαστήριο Αλγοριθμικής &amp; ΓΛΩΣΣΑΣ" FontSize="11"/></StackPanel></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="FocusButton" Style="{StaticResource ToolButton}" Content="▣  Focus" Click="Focus_Click"/><Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Content="☾  Θέμα" Click="Theme_Click"/></StackPanel></Grid></Border>
<Border x:Name="Toolbar" Grid.Row="1" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Margin="14,4">
<Button x:Name="NewButton" Style="{StaticResource ToolButton}" Content="＋  Νέο" Click="New_Click"/><Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Content="⌂  Άνοιγμα" Click="Open_Click"/><Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Content="▣  Αποθήκευση" Click="Save_Click"/>
<Border Width="1" Margin="9,6"/><Button x:Name="RunButton" Style="{StaticResource ToolButton}" Content="▶  Εκτέλεση   F5" Click="Run_Click"/><Button x:Name="StepButton" Style="{StaticResource ToolButton}" Content="⏭  Βήμα   F10" Click="Step_Click"/><Button x:Name="FlowButton" Style="{StaticResource ToolButton}" Content="◇  Διάγραμμα" Click="Flow_Click"/><Button x:Name="ClearButton" Style="{StaticResource ToolButton}" Content="■  Καθαρισμός" Click="Clear_Click"/><Button x:Name="PanelButton" Style="{StaticResource ToolButton}" Content="◧  Panel" Click="Panel_Click"/></StackPanel></Border>
<Grid Grid.Row="2" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="420"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
<Border x:Name="EditorCard" CornerRadius="12" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
<Border x:Name="EditorHeader" CornerRadius="12,12,0,0"><Grid Margin="14,0"><TextBlock x:Name="EditorHeaderText" Text="Κώδικας" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="FileText" Text="χωρίς τίτλο.glossa" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Border>
<TabControl x:Name="WorkTabs" Grid.Row="1" BorderThickness="0" SelectionChanged="WorkTabs_SelectionChanged"><TabItem Header="Κώδικας"><avalon:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="Cascadia Mono,Consolas" FontSize="15" Padding="10,12" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="Editor_TextChanged" KeyDown="Editor_KeyDown"/></TabItem><TabItem Header="Διάγραμμα Ροής"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="FlowCanvas" Width="760" MinHeight="900"/></ScrollViewer></TabItem></TabControl></Grid></Border>
<GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Background="#263650" Cursor="SizeWE"/>
<Border x:Name="OutputCard" Grid.Column="2" CornerRadius="12" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="180" MinHeight="100"/><RowDefinition Height="8"/><RowDefinition Height="180" MinHeight="100"/></Grid.RowDefinitions>
<Border x:Name="ConsoleHeader" CornerRadius="12,12,0,0"><TextBlock x:Name="ConsoleHeaderText" Text="  Κονσόλα" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><TextBox x:Name="ConsoleBox" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="14" Padding="14" BorderThickness="0" Text="Έτοιμο για εκτέλεση." TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<GridSplitter x:Name="ConsoleVariablesSplitter" Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS"/><Border x:Name="VariablesPanel" Grid.Row="3" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="VariablesTitle" Text="Μεταβλητές" FontWeight="SemiBold" VerticalAlignment="Center"/><DataGrid x:Name="VariablesGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Όνομα" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Τιμή" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
<GridSplitter x:Name="VariablesTraceSplitter" Grid.Row="4" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS"/><Border x:Name="TracePanel" Grid.Row="5" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="TraceTitle" Text="Πίνακας Τιμών" FontWeight="SemiBold" VerticalAlignment="Center"/><DataGrid x:Name="TraceGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal"/></Grid></Border>
</Grid></Border></Grid>
<Border x:Name="StatusBar" Grid.Row="3"><Grid Margin="12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Έτοιμο" FontSize="11" VerticalAlignment="Center"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CreatorText" Text="Created by Konstantinos Psarras" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock x:Name="VersionText" Text="Algora v0.1.0-alpha.7   •   F11 Πλήρης οθόνη" FontSize="11" VerticalAlignment="Center"/></StackPanel></Grid></Border>
</Grid></Window>